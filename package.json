{
  "name": "moce-voxel-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "mcp:server": "node packages/mcp-server/src/index.mjs",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "cf:types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply moce-worldmaker-staging --local",
    "db:migrate:staging": "wrangler d1 migrations apply moce-worldmaker-staging --remote",
    "db:migrate:production": "wrangler d1 migrations apply moce-worldmaker --remote --env production",
    "migrate:staging": "node scripts/migrate-json-to-cloudflare.mjs --database moce-worldmaker-staging --bucket moce-worldmaker-staging",
    "migrate:production": "node scripts/migrate-json-to-cloudflare.mjs --database moce-worldmaker --bucket moce-worldmaker --env production",
    "deploy:staging": "npm run build && wrangler deploy",
    "build:production": "CLOUDFLARE_ENV=production npm run build",
    "deploy": "npm run build:production && wrangler deploy dist/moce_worldmaker_staging/index.js --config wrangler.jsonc --env production --assets dist/client --no-bundle"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "three": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.49.0",
    "@cloudflare/workers-types": "^5.20260730.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "jsdom": "latest",
    "vitest": "latest",
    "wrangler": "^4.116.0"
  }
}
